# Copy to .env and adjust. Every value is optional; the defaults below are what the app uses.

# Any SQLAlchemy async URL. Default: SQLite file in data_store/
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/geo

MAX_UPLOAD_SIZE_MB=50
MAX_UNCOMPRESSED_SIZE_MB=250
MAX_ZIP_ENTRIES=500
MAX_FEATURES=250000

DEDUPLICATE_UPLOADS=true
KEEP_UPLOADED_FILES=true
DISTORTION_WARNING_PCT=0.5

# JSON list. Restrict this in production.
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
